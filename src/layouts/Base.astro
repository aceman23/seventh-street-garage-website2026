---
import Seo from '@/components/Seo.astro';
import Strip from '@/components/Strip.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CtaBand from '@/components/CtaBand.astro';
import FloatingCall from '@/components/FloatingCall.astro';
import '@/styles/global.css';
import type { Node } from '@/lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  graph?: Node[];
  active?: 'areas' | 'services' | 'release' | 'auction' | 'about' | 'contact' | 'search';
  noindex?: boolean;
}
const { title, description, path, graph, active, noindex } = Astro.props;
const supabaseUrl = import.meta.env.VITE_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Seo title={title} description={description} path={path} graph={graph} noindex={noindex} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JB0MCG1BHG"></script>
    <script is:inline define:vars={{ GA_ID: 'G-JB0MCG1BHG' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Strip />
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <CtaBand />
    <Footer />
    <FloatingCall />
    <div id="env-config" data-supabase-url={supabaseUrl} data-supabase-key={supabaseAnonKey} hidden></div>
    <script>
      import '@/scripts/site.ts';
    </script>
  </body>
</html>
