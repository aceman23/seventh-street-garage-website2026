---
import { SITE } from '@/data/site';
import { YARDS } from '@/data/cities';
import { SERVICES } from '@/data/services';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const popular = ['wilmington', 'san-pedro', 'long-beach', 'carson', 'torrance', 'compton', 'bell-gardens', 'downey', 'anaheim', 'huntington-beach'];
const svc = SERVICES.slice(0, 10);
const yardKeys = Object.keys(YARDS) as (keyof typeof YARDS)[];
const showFb = Boolean(SITE.facebook);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h2>Seventh Street Garage</h2>
        <p>24/7 towing, roadside, recovery and secure vehicle storage across Los Angeles and northern Orange County.</p>
        <a href={`tel:${SITE.tel}`} class="num">{SITE.phone}</a>
        <p style="margin-top:.5rem">Dispatch 24 hrs · 7 days · 365 days</p>
        <div class="social">
          <a href={SITE.instagram} rel="noopener" target="_blank" aria-label="Instagram"><Icon name="instagram" /></a>
          {showFb && <a href={SITE.facebook} rel="noopener" target="_blank" aria-label="Facebook"><Icon name="facebook" /></a>}
        </div>
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          {svc.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Popular areas</h2>
        <ul>
          {popular.map((slug) => <li><a href={`/service-areas/${slug}/`}>Towing in {slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</a></li>)}
          <li><a href="/service-areas/">All service areas &rarr;</a></li>
        </ul>
      </div>
      <div>
        <h2>Yards</h2>
        {yardKeys.map((k) => (
          <address style="margin-bottom:.85rem">
            <strong>{YARDS[k].label}</strong><br />
            {YARDS[k].addr}<br />
            {YARDS[k].city}, CA {YARDS[k].zip}
          </address>
        ))}
        <h2 style="margin-top:1rem">Office</h2>
        <p>Vehicle release 8am–5pm</p>
        <ul>
          <li><a href="/vehicle-release/">Vehicle release</a></li>
          <li><a href="/search-vehicles/">Search vehicles</a></li>
          <li><a href="/auction/">Auction</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} {SITE.legalName} · LAPD Official Police Garage Unit 5</span>
      <span>
        <a href="/privacy/">Privacy</a> ·
        <a href="/terms/">Terms</a> ·
        <a href="/sitemap-index.xml">Sitemap</a> ·
        <a href="/admin/">Admin</a>
      </span>
    </div>
  </div>
</footer>
